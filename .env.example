# =============================================================================
# Nebula Noir — environment template
# Copy to .env.local for local Next.js. On Vercel, set the same keys in Project
# Settings → Environment Variables (Production / Preview / Development).
#
# Demo Mode: leave NEXT_PUBLIC_SUPABASE_URL and/or NEXT_PUBLIC_SUPABASE_ANON_KEY
# empty. The site still renders from src/lib/fixtures. Writes no-op with a toast.
# Production needs Supabase public keys + service role. R2, Instagram, and cron
# are optional per feature (gallery upload, IG grid, daily sync).
# =============================================================================

# --- Supabase (Postgres, Auth, RLS) -----------------------------------------
# Leave both public keys empty to force Demo Mode.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Never prefix NEXT_PUBLIC_. Never import in client.
# Used by Instagram sync (service client) and must stay encrypted on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (gallery images + hero video + cached IG stills) ---------
# Required together for isR2Configured(): all six must be set.
# Without R2: gallery metadata can still live in Supabase if public_url is set
# another way, but Admin gallery upload and hero presign fail.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nebula-noir-gallery
# S3-compatible API endpoint (not the public media URL):
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public base URL for <img> / <video> (r2.dev or custom domain). No trailing slash.
R2_PUBLIC_URL=https://<bucket>.<account>.r2.dev

# --- Instagram API with Instagram Login -------------------------------------
# Host: graph.instagram.com — not Facebook Login, not Messenger, not publishing.
# Scope: instagram_business_basic
# Handle: @nebula_noir.official (Professional / Business or Creator account)
#
# Runtime needs INSTAGRAM_ACCESS_TOKEN (long-lived, ~60 days). Sync stores a
# refreshed token in instagram_auth when that table exists.
INSTAGRAM_ACCESS_TOKEN=
# Optional. If empty, GET /me supplies user_id.
INSTAGRAM_USER_ID=
# Optional Meta app id — documentation / dashboard only. Not read at runtime.
INSTAGRAM_APP_ID=
# Used only when exchanging a short-lived token for a long-lived one
# (see DEPLOYMENT.md). Not required at request time after bootstrap.
INSTAGRAM_APP_SECRET=
# Graph version path segment. Default in code: v22.0
INSTAGRAM_GRAPH_VERSION=v22.0

# --- Hero video override ----------------------------------------------------
# Optional. If set, this URL wins over Admin upload (brand_info.hero_video).
# Empty = Admin upload, or the original Art Deco pattern if none uploaded.
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- Cron -------------------------------------------------------------------
# Protects GET /api/cron/instagram. The route accepts only the header
# `Authorization: Bearer $CRON_SECRET`. Vercel Cron sends that header
# automatically when this variable is set. If unset or wrong, all callers get 401.
CRON_SECRET=
