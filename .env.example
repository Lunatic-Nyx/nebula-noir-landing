# =============================================================================
# Nebula Noir — environment template
# Copy to .env.local for local Next.js. On Vercel, set the same keys in Project
# Settings → Environment Variables (Production / Preview / Development).
#
# Demo Mode: leave NEXT_PUBLIC_SUPABASE_URL and/or NEXT_PUBLIC_SUPABASE_ANON_KEY
# empty. The site still renders from src/lib/fixtures. Writes no-op with a toast.
# Production needs Supabase public keys + service role. R2, Instagram, and cron
# are optional per feature (gallery upload, IG grid, daily sync).
# =============================================================================

# --- Supabase (Postgres, Auth, RLS) -----------------------------------------
# Leave both public keys empty to force Demo Mode.
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Bypasses RLS. Never prefix NEXT_PUBLIC_. Never import in client.
# Used by Instagram sync (service client) and must stay encrypted on Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Server/build only. OPTIONAL override for the deploy-time schema apply. The
# runner first looks for this, then for the Postgres connection strings the
# Vercel Supabase integration exports automatically:
#   POSTGRES_URL_NON_POOLING, POSTGRES_URL, DATABASE_URL, POSTGRES_PRISMA_URL
# So if the integration is connected you usually do NOT need to set this.
# IMPORTANT: use the Supabase **Session pooler** string (IPv4). The **Direct
# connection** (db.<ref>.supabase.co:5432) is IPv6-only and will NOT connect
# from a Vercel build:
#   postgresql://postgres.<ref>:<URL-ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Never prefix NEXT_PUBLIC_; never import in client code; scope to Production.
# Leave empty to use the integration vars (or skip in local/Demo Mode). If the
# apply cannot run, the build continues with a warning by default; set
# DB_MIGRATE_REQUIRED=1 to fail the build instead. Never use sslmode=disable,
# sslmode=no-verify or uselibpqcompat for a remote host.
SUPABASE_DB_URL=

# Set to 1 to fail the build when the schema apply cannot run or errors instead
# of warning and continuing. Use on the project that owns the schema.
DB_MIGRATE_REQUIRED=

# Set to 1 to explicitly skip the deploy-time schema apply (emergency bypass;
# e.g. the database is temporarily unreachable and you must ship anyway).
DB_MIGRATE_SKIP=

# Preview/Development builds skip the apply even if a Postgres URL is present,
# so a branch build cannot mutate the production database. Set to 1 only if a
# preview should apply the schema on purpose (e.g. a staging database).
DB_MIGRATE_ALLOW_PREVIEW=

# --- Cloudflare R2 (gallery images + hero video + cached IG stills) ---------
# Required together for isR2Configured(): all six must be set.
# Without R2: gallery metadata can still live in Supabase if public_url is set
# another way, but Admin gallery upload and hero presign fail.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nebula-noir-gallery
# S3-compatible API endpoint (not the public media URL):
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Public base URL for <img> / <video> (r2.dev or custom domain). No trailing slash.
R2_PUBLIC_URL=https://<bucket>.<account>.r2.dev

# --- Instagram API with Instagram Login -------------------------------------
# Host: graph.instagram.com — not Facebook Login, not Messenger, not publishing.
# Scope: instagram_business_basic
# Handle: @nebula_noir.official (Professional / Business or Creator account)
#
# Runtime needs INSTAGRAM_ACCESS_TOKEN (long-lived, ~60 days). Sync stores a
# refreshed token in instagram_auth when that table exists.
INSTAGRAM_ACCESS_TOKEN=
# Optional. If empty, GET /me supplies user_id.
INSTAGRAM_USER_ID=
# Optional Meta app id — documentation / dashboard only. Not read at runtime.
INSTAGRAM_APP_ID=
# Used only when exchanging a short-lived token for a long-lived one
# (see DEPLOYMENT.md). Not required at request time after bootstrap.
INSTAGRAM_APP_SECRET=
# Graph version path segment. Default in code: v22.0
INSTAGRAM_GRAPH_VERSION=v22.0

# --- Resend (contact form notification email) -------------------------------
# Server only. Never prefix NEXT_PUBLIC_. Enables a best-effort notification
# email to CONTACT_TO_EMAIL when the contact form is submitted. The inquiry is
# always stored in Supabase; a mail failure never fails the form.
# Can also be stored encrypted via Admin → Secrets; this env var is the fallback.
RESEND=
# Verified sender for the notification (the domain must be verified in Resend).
# Optional. Default: contact@nebula-noir.com
CONTACT_FROM_EMAIL=
# Recipient of new-inquiry notifications. Optional. Default: contact@nebula-noir.com
CONTACT_TO_EMAIL=

# --- Hero video override ----------------------------------------------------
# Optional. If set, this URL wins over Admin upload (brand_info.hero_video).
# Empty = Admin upload, or the original Art Deco pattern if none uploaded.
NEXT_PUBLIC_HERO_VIDEO_URL=

# --- Admin secret store -----------------------------------------------------
# Enables editing RESEND / INSTAGRAM_* / CONTACT_* from the admin UI. 32 random
# bytes as 64 hex chars. Server only. Losing/rotating it makes stored secrets
# unreadable (env fallbacks still work).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_ENCRYPTION_KEY=

# --- Cron -------------------------------------------------------------------
# Protects GET /api/cron/instagram. The route accepts only the header
# `Authorization: Bearer $CRON_SECRET`. Vercel Cron sends that header
# automatically when this variable is set. If unset or wrong, all callers get 401.
CRON_SECRET=
